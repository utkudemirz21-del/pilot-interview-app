current_id = 11
while len(questions) < 100:
    for topic, kws, ans in topics:
        if len(questions) >= 100:
            break
        cat, diff = categories[(len(questions)) % len(categories)]
        questions.append({
            "id": current_id,
            "category": cat,
            "difficulty": diff,
            "question": topic,
            "keywords": kws,
            "model_answer": ans
        })
        current_id += 1

# Veriyi JSON dosyasına yaz
file_path = "questions.json"
with open(file_path, "w", encoding="utf-8") as f:
    json.dump(questions, f, ensure_ascii=False, indent=2)

print(f"Toplam {len(questions)} soru başarıyla hazırlatıldı ve 'questions.json' olarak kaydedildi.")
